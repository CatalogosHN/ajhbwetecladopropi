<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyStyle" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <!-- ¡EL MARGEN QUE SEPARA LAS TECLAS! -->
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    
    <style name="KeyStyleAction" parent="KeyStyle">
        <item name="android:background">@drawable/bg_key_action</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
