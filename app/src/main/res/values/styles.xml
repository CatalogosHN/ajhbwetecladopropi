<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para las teclas normales (Letras y números) -->
    <style name="KeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Estilo para las teclas de acción (Enter, Borrar, Shift, etc.) -->
    <style name="KeyStyleAction" parent="KeyStyle">
        <item name="android:backgroundTint">#B0BEC5</item>
    </style>
</resources>
