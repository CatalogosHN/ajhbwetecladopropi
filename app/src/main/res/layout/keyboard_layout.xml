<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E" 
    android:paddingBottom="4dp"
    android:splitMotionEvents="true">

    <!-- BARRA DE SUGERENCIAS -->
    <LinearLayout android:id="@+id/layout_suggestions_bar" android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:visibility="gone" android:background="#D1D4D9" android:padding="2dp">
        <Button android:id="@+id/btnSuggest1" android:tag="SUGGESTION" style="@style/KeyStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textAllCaps="false" android:textSize="15sp" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#B0B0B0" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnSuggest2" android:tag="SUGGESTION" style="@style/KeyStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textStyle="bold" android:textAllCaps="false" android:textSize="16sp" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#B0B0B0" android:layout_margin="4dp"/>
        <Button android:id="@+id/btnSuggest3" android:tag="SUGGESTION" style="@style/KeyStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textAllCaps="false" android:textSize="15sp" />
    </LinearLayout>

    <!-- BARRA SUPERIOR DE HERRAMIENTAS -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="45dp">
        <LinearLayout android:id="@+id/layout_top_bar" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="2dp">
            <Button android:tag="OPEN_QR_MODE" android:text="⚡" style="@style/KeyStyleAction" android:layout_weight="1" />
            <Button android:tag="CLIPBOARD" android:text="📋" style="@style/KeyStyleAction" android:layout_weight="1" />
            <Button android:tag="OPEN_TRANSLATOR" android:text="🌐" style="@style/KeyStyleAction" android:layout_weight="1" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <Button android:id="@+id/btnMic1" android:tag="MIC" android:text="🎤" style="@style/KeyStyleAction" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layout_qr_search_bar" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:visibility="gone" android:padding="2dp">
            <TextView android:id="@+id/tvQrSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🔍 Buscar: " android:gravity="center_vertical" android:textStyle="bold" android:paddingStart="12dp"/>
            <Button android:tag="CLEAR_QR_SEARCH" android:text="⌫" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="8dp"/>
            <Button android:tag="CLOSE_QR_MODE" android:text="❌" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layout_translator_bar" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:visibility="gone" android:padding="2dp">
            <Button android:id="@+id/btnLangToggle" android:tag="IGNORE" android:text="ES ➔ EN" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:textSize="13sp" android:paddingStart="8dp" android:paddingEnd="8dp" />
            <Button android:id="@+id/btnTranslateSend" android:tag="OPEN_TRANSLATOR" android:text="✨ Traducir texto" style="@style/KeyStyleAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:textSize="13sp" />
            <Button android:tag="CLOSE_TRANSLATOR" android:text="❌" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="12dp" android:paddingEnd="12dp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_quick_replies_keyboard" android:layout_width="match_parent" android:layout_height="180dp" android:visibility="gone" android:background="#121212" android:padding="4dp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:splitMotionEvents="true">
        
        <!-- PÁGINA A: LETRAS -->
        <LinearLayout android:id="@+id/layout_letters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible" android:splitMotionEvents="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="2dp" android:splitMotionEvents="true">
                <Button android:text="q" android:tag="1" style="@style/KeyStyle" />
                <Button android:text="w" android:tag="2" style="@style/KeyStyle" />
                <Button android:text="e" android:tag="3" style="@style/KeyStyle" />
                <Button android:text="r" android:tag="4" style="@style/KeyStyle" />
                <Button android:text="t" android:tag="5" style="@style/KeyStyle" />
                <Button android:text="y" android:tag="6" style="@style/KeyStyle" />
                <Button android:text="u" android:tag="7" style="@style/KeyStyle" />
                <Button android:text="i" android:tag="8" style="@style/KeyStyle" />
                <Button android:text="o" android:tag="9" style="@style/KeyStyle" />
                <Button android:text="p" android:tag="0" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="2dp" android:splitMotionEvents="true">
                <Button android:text="a" style="@style/KeyStyle" />
                <Button android:text="s" style="@style/KeyStyle" />
                <Button android:text="d" style="@style/KeyStyle" />
                <Button android:text="f" style="@style/KeyStyle" />
                <Button android:text="g" style="@style/KeyStyle" />
                <Button android:text="h" style="@style/KeyStyle" />
                <Button android:text="j" style="@style/KeyStyle" />
                <Button android:text="k" style="@style/KeyStyle" />
                <Button android:text="l" style="@style/KeyStyle" />
                <Button android:text="ñ" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="2dp" android:splitMotionEvents="true">
                <Button android:tag="SHIFT" android:text="⇧" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:text="z" style="@style/KeyStyle" />
                <Button android:text="x" style="@style/KeyStyle" />
                <Button android:text="c" style="@style/KeyStyle" />
                <Button android:text="v" style="@style/KeyStyle" />
                <Button android:text="b" style="@style/KeyStyle" />
                <Button android:text="n" style="@style/KeyStyle" />
                <Button android:text="m" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="2dp" android:splitMotionEvents="true">
                <Button android:tag="MODE_SYM1" android:text="\?123" style="@style/KeyStyleAction" android:layout_weight="1.5" android:textSize="14sp" />
                <Button android:text="," style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="OPEN_EMOJI" android:text="😀" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:tag="SPACE" android:text="Dev&lt;&gt;BrayanR" style="@style/KeyStyleAction" android:layout_weight="5" />
                <Button android:text="." style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:layout_weight="1.5" android:backgroundTint="#4285F4" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- PÁGINA B: SÍMBOLOS 1 -->
        <LinearLayout android:id="@+id/layout_symbols_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:splitMotionEvents="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="+" style="@style/KeyStyle" />
                <Button android:text="×" style="@style/KeyStyle" />
                <Button android:text="÷" style="@style/KeyStyle" />
                <Button android:text="=" style="@style/KeyStyle" />
                <Button android:text="/" style="@style/KeyStyle" />
                <Button android:text="_" style="@style/KeyStyle" />
                <Button android:text="&lt;" style="@style/KeyStyle" />
                <Button android:text="&gt;" style="@style/KeyStyle" />
                <Button android:text="[" style="@style/KeyStyle" />
                <Button android:text="]" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="!" style="@style/KeyStyle" />
                <Button android:text="@" style="@style/KeyStyle" />
                <Button android:text="#" style="@style/KeyStyle" />
                <Button android:text="$" style="@style/KeyStyle" />
                <Button android:text="%" style="@style/KeyStyle" />
                <Button android:text="^" style="@style/KeyStyle" />
                <Button android:text="&amp;" style="@style/KeyStyle" />
                <Button android:text="*" style="@style/KeyStyle" />
                <Button android:text="(" style="@style/KeyStyle" />
                <Button android:text=")" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:tag="MODE_SYM2" android:text="1/2" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:text="-" style="@style/KeyStyle" />
                <Button android:text="'" style="@style/KeyStyle" />
                <Button android:text="&quot;" style="@style/KeyStyle" />
                <Button android:text=":" style="@style/KeyStyle" />
                <Button android:text=";" style="@style/KeyStyle" />
                <Button android:text="\?" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:tag="MODE_LETTERS" android:text="ABC" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:tag="MODE_NUMPAD" android:text="123" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:text="," style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="SPACE" android:text="Dev&lt;&gt;BrayanR" style="@style/KeyStyleAction" android:layout_weight="3" />
                <Button android:text="." style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:layout_weight="1.5" android:backgroundTint="#4285F4" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- PÁGINA C: SÍMBOLOS 2 -->
        <LinearLayout android:id="@+id/layout_symbols_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:splitMotionEvents="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="`" style="@style/KeyStyle" />
                <Button android:text="~" style="@style/KeyStyle" />
                <Button android:text="\\" style="@style/KeyStyle" />
                <Button android:text="|" style="@style/KeyStyle" />
                <Button android:text="{" style="@style/KeyStyle" />
                <Button android:text="}" style="@style/KeyStyle" />
                <Button android:text="€" style="@style/KeyStyle" />
                <Button android:text="£" style="@style/KeyStyle" />
                <Button android:text="¥" style="@style/KeyStyle" />
                <Button android:text="₩" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="°" style="@style/KeyStyle" />
                <Button android:text="•" style="@style/KeyStyle" />
                <Button android:text="○" style="@style/KeyStyle" />
                <Button android:text="●" style="@style/KeyStyle" />
                <Button android:text="□" style="@style/KeyStyle" />
                <Button android:text="■" style="@style/KeyStyle" />
                <Button android:text="♤" style="@style/KeyStyle" />
                <Button android:text="♡" style="@style/KeyStyle" />
                <Button android:text="◇" style="@style/KeyStyle" />
                <Button android:text="♧" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:tag="MODE_SYM1" android:text="2/2" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:text="☆" style="@style/KeyStyle" />
                <Button android:text="▪" style="@style/KeyStyle" />
                <Button android:text="¤" style="@style/KeyStyle" />
                <Button android:text="《" style="@style/KeyStyle" />
                <Button android:text="》" style="@style/KeyStyle" />
                <Button android:text="¡" style="@style/KeyStyle" />
                <Button android:text="¿" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:tag="MODE_LETTERS" android:text="ABC" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:tag="MODE_NUMPAD" android:text="123" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:text="," style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="SPACE" android:text="Dev&lt;&gt;BrayanR" style="@style/KeyStyleAction" android:layout_weight="3" />
                <Button android:text="." style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:layout_weight="1.5" android:backgroundTint="#4285F4" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- NUMPAD -->
        <LinearLayout android:id="@+id/layout_numpad" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:splitMotionEvents="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="1" style="@style/KeyStyle" />
                <Button android:text="2" style="@style/KeyStyle" />
                <Button android:text="3" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="4" style="@style/KeyStyle" />
                <Button android:text="5" style="@style/KeyStyle" />
                <Button android:text="6" style="@style/KeyStyle" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:backgroundTint="#4285F4" android:textColor="#FFFFFF" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:text="7" style="@style/KeyStyle" />
                <Button android:text="8" style="@style/KeyStyle" />
                <Button android:text="9" style="@style/KeyStyle" />
                <Button android:text="-" style="@style/KeyStyleAction" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:padding="2dp" android:splitMotionEvents="true">
                <Button android:tag="MODE_LETTERS" android:text="ABC" style="@style/KeyStyleAction" />
                <Button android:text="0" style="@style/KeyStyle" />
                <Button android:text="." style="@style/KeyStyleAction" />
                <Button android:tag="SPACE" android:text="Espacio" style="@style/KeyStyleAction" />
            </LinearLayout>
        </LinearLayout>

        <!-- PORTAPAPELES -->
        <LinearLayout android:id="@+id/layout_clipboard" android:layout_width="match_parent" android:layout_height="250dp" android:orientation="vertical" android:visibility="gone" android:background="#121212">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:padding="4dp" android:background="#1E1E1E">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Portapapeles" android:textStyle="bold" android:gravity="center_vertical" android:paddingStart="12dp" android:textColor="#FFFFFF"/>
                <Button android:tag="CLEAR_CLIPBOARD" android:text="🗑️ Limpiar" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:padding="4dp" />
                <Button android:tag="MODE_LETTERS" android:text="❌ Cerrar" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="4dp" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/keyboard_recycler_view" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp"/>
                <Button android:id="@+id/btnClipboardEnter" android:tag="ENTER" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="bottom|end" android:layout_margin="16dp" android:text="↵" android:textColor="#FFFFFF" android:textSize="24sp" android:elevation="6dp" android:backgroundTint="#4285F4"/>
            </FrameLayout>
        </LinearLayout>

        <!-- EMOJIS MASIVOS -->
        <LinearLayout android:id="@+id/layout_emojis" android:layout_width="match_parent" android:layout_height="220dp" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:orientation="horizontal" android:padding="4dp">
                <Button android:tag="MODE_LETTERS" android:text="ABC" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="4dp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Emojis de WhatsApp" android:gravity="center" android:textStyle="bold"/>
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_width="wrap_content" android:layout_height="match_parent" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_emojis_keyboard" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp"/>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
