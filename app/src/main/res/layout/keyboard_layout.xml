<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D1D5DB"
    android:paddingBottom="8dp">

    <!-- EL PORTAPAPELES ANCLADO -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/keyboard_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#F3F4F6"/>

    <!-- FILA DE NÚMEROS FIJA -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
        <Button android:text="1" style="@style/KeyStyle" />
        <Button android:text="2" style="@style/KeyStyle" />
        <Button android:text="3" style="@style/KeyStyle" />
        <Button android:text="4" style="@style/KeyStyle" />
        <Button android:text="5" style="@style/KeyStyle" />
        <Button android:text="6" style="@style/KeyStyle" />
        <Button android:text="7" style="@style/KeyStyle" />
        <Button android:text="8" style="@style/KeyStyle" />
        <Button android:text="9" style="@style/KeyStyle" />
        <Button android:text="0" style="@style/KeyStyle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- PÁGINA A: LETRAS -->
        <LinearLayout android:id="@+id/layout_letters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:text="q" style="@style/KeyStyle" />
                <Button android:text="w" style="@style/KeyStyle" />
                <Button android:text="e" style="@style/KeyStyle" />
                <Button android:text="r" style="@style/KeyStyle" />
                <Button android:text="t" style="@style/KeyStyle" />
                <Button android:text="y" style="@style/KeyStyle" />
                <Button android:text="u" style="@style/KeyStyle" />
                <Button android:text="i" style="@style/KeyStyle" />
                <Button android:text="o" style="@style/KeyStyle" />
                <Button android:text="p" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5"/>
                <Button android:text="a" style="@style/KeyStyle" />
                <Button android:text="s" style="@style/KeyStyle" />
                <Button android:text="d" style="@style/KeyStyle" />
                <Button android:text="f" style="@style/KeyStyle" />
                <Button android:text="g" style="@style/KeyStyle" />
                <Button android:text="h" style="@style/KeyStyle" />
                <Button android:text="j" style="@style/KeyStyle" />
                <Button android:text="k" style="@style/KeyStyle" />
                <Button android:text="l" style="@style/KeyStyle" />
                <Button android:text="ñ" style="@style/KeyStyle" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:tag="SHIFT" android:text="⇧" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:text="z" style="@style/KeyStyle" />
                <Button android:text="x" style="@style/KeyStyle" />
                <Button android:text="c" style="@style/KeyStyle" />
                <Button android:text="v" style="@style/KeyStyle" />
                <Button android:text="b" style="@style/KeyStyle" />
                <Button android:text="n" style="@style/KeyStyle" />
                <Button android:text="m" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:tag="MODE_SYM1" android:text="!#1" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:id="@+id/btnMic1" android:tag="MIC" android:text="🎤" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:tag="CLIPBOARD" android:text="📋" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:text="," style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="SPACE" android:text="Español (US)" style="@style/KeyStyleAction" android:layout_weight="3" />
                <Button android:text="." style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
        </LinearLayout>

        <!-- PÁGINA B: SÍMBOLOS 1 -->
        <LinearLayout android:id="@+id/layout_symbols_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:text="+" style="@style/KeyStyle" />
                <Button android:text="×" style="@style/KeyStyle" />
                <Button android:text="÷" style="@style/KeyStyle" />
                <Button android:text="=" style="@style/KeyStyle" />
                <Button android:text="/" style="@style/KeyStyle" />
                <Button android:text="_" style="@style/KeyStyle" />
                <Button android:text="&lt;" style="@style/KeyStyle" />
                <Button android:text="&gt;" style="@style/KeyStyle" />
                <Button android:text="[" style="@style/KeyStyle" />
                <Button android:text="]" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:text="!" style="@style/KeyStyle" />
                <Button android:text="@" style="@style/KeyStyle" />
                <Button android:text="#" style="@style/KeyStyle" />
                <Button android:text="$" style="@style/KeyStyle" />
                <Button android:text="%" style="@style/KeyStyle" />
                <Button android:text="^" style="@style/KeyStyle" />
                <Button android:text="&amp;" style="@style/KeyStyle" />
                <Button android:text="*" style="@style/KeyStyle" />
                <Button android:text="(" style="@style/KeyStyle" />
                <Button android:text=")" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:tag="MODE_SYM2" android:text="1/2" style="@style/KeyStyleAction" android:layout_weight="1.5"/>
                <Button android:text="-" style="@style/KeyStyle" />
                <Button android:text="'" style="@style/KeyStyle" />
                <Button android:text="&quot;" style="@style/KeyStyle" />
                <Button android:text=":" style="@style/KeyStyle" />
                <Button android:text=";" style="@style/KeyStyle" />
                <Button android:text="," style="@style/KeyStyle" />
                <Button android:text="?" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:tag="MODE_LETTERS" android:text="ABC" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:id="@+id/btnMic2" android:tag="MIC" android:text="🎤" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:tag="CLIPBOARD" android:text="📋" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:text="," style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="SPACE" android:text="Español (US)" style="@style/KeyStyleAction" android:layout_weight="3" />
                <Button android:text="." style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
        </LinearLayout>

        <!-- PÁGINA C: SÍMBOLOS 2 -->
        <LinearLayout android:id="@+id/layout_symbols_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:text="`" style="@style/KeyStyle" />
                <Button android:text="~" style="@style/KeyStyle" />
                <Button android:text="\\" style="@style/KeyStyle" />
                <Button android:text="|" style="@style/KeyStyle" />
                <Button android:text="{" style="@style/KeyStyle" />
                <Button android:text="}" style="@style/KeyStyle" />
                <Button android:text="€" style="@style/KeyStyle" />
                <Button android:text="£" style="@style/KeyStyle" />
                <Button android:text="¥" style="@style/KeyStyle" />
                <Button android:text="₩" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:text="°" style="@style/KeyStyle" />
                <Button android:text="•" style="@style/KeyStyle" />
                <Button android:text="○" style="@style/KeyStyle" />
                <Button android:text="●" style="@style/KeyStyle" />
                <Button android:text="□" style="@style/KeyStyle" />
                <Button android:text="■" style="@style/KeyStyle" />
                <Button android:text="♤" style="@style/KeyStyle" />
                <Button android:text="♡" style="@style/KeyStyle" />
                <Button android:text="◇" style="@style/KeyStyle" />
                <Button android:text="♧" style="@style/KeyStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:tag="MODE_SYM1" android:text="2/2" style="@style/KeyStyleAction" android:layout_weight="1.5"/>
                <Button android:text="☆" style="@style/KeyStyle" />
                <Button android:text="▪" style="@style/KeyStyle" />
                <Button android:text="¤" style="@style/KeyStyle" />
                <Button android:text="《" style="@style/KeyStyle" />
                <Button android:text="》" style="@style/KeyStyle" />
                <Button android:text="¡" style="@style/KeyStyle" />
                <Button android:text="¿" style="@style/KeyStyle" />
                <Button android:tag="DELETE" android:text="⌫" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:padding="2dp">
                <Button android:tag="MODE_LETTERS" android:text="ABC" style="@style/KeyStyleAction" android:layout_weight="1.5" />
                <Button android:id="@+id/btnMic3" android:tag="MIC" android:text="🎤" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:tag="CLIPBOARD" android:text="📋" style="@style/KeyStyleAction" android:layout_weight="1" />
                <Button android:text="," style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="SPACE" android:text="Español (US)" style="@style/KeyStyleAction" android:layout_weight="3" />
                <Button android:text="." style="@style/KeyStyle" android:layout_weight="1" />
                <Button android:tag="ENTER" android:text="↵" style="@style/KeyStyleAction" android:layout_weight="1.5" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
